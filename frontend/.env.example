NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_AUTH_MODE=local

# Set these when NEXT_PUBLIC_AUTH_MODE=cognito. Use a public Cognito app client
# configured for authorization-code flow with PKCE and no client secret.
# NEXT_PUBLIC_COGNITO_DOMAIN=https://your-domain.auth.ap-south-1.amazoncognito.com
# NEXT_PUBLIC_COGNITO_CLIENT_ID=your-public-app-client-id
# NEXT_PUBLIC_COGNITO_REDIRECT_URI=https://your-app.example.com/
# NEXT_PUBLIC_COGNITO_LOGOUT_URI=https://your-app.example.com/
