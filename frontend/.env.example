NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_AUTH_MODE=local

# Set these when NEXT_PUBLIC_AUTH_MODE=auth0. Configure a Single Page Application
# and API in Auth0; use authorization-code flow with PKCE and no client secret.
# Allow only the exact callback, logout, and web-origin URLs for each environment.
# NEXT_PUBLIC_AUTH0_DOMAIN=https://your-tenant.us.auth0.com
# NEXT_PUBLIC_AUTH0_CLIENT_ID=your-public-client-id
# NEXT_PUBLIC_AUTH0_API_AUDIENCE=https://api.solvix.example
# NEXT_PUBLIC_AUTH0_REDIRECT_URI=https://your-vercel-app.vercel.app/
# NEXT_PUBLIC_AUTH0_LOGOUT_URI=https://your-vercel-app.vercel.app/
